class Solution(object):
    def countCompleteComponents(self, n, edges):
        graph = [[] for _ in range(n)]
        for u, v in edges:
            graph[u].append(v)
            graph[v].append(u)
        visited = [False] * n
        ans = 0
        def dfs(node):
            visited[node] = True
            nodes.append(node)
            for nei in graph[node]:
                if not visited[nei]:
                    dfs(nei)
        for i in range(n):
            if not visited[i]:
                nodes = []
                dfs(i)
                total_edges = 0
                size = len(nodes)
                for node in nodes:
                    total_edges += len(graph[node])
                total_edges //= 2
                if total_edges == size * (size - 1) // 2:
                    ans += 1
        return ans
