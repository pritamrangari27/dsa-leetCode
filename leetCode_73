class Solution(object):
    def setZeroes(self, matrix):
        row=len(matrix)
        col=len(matrix[0])
        rows=[0]*row
        cols=[0]*col
        for i in range(row):
            for j in range(col):
                if matrix[i][j]==0:
                    rows[i]=-1
                    cols[j]=-1
        for i in range(row):
            for j in range(col):
                if rows[i]==-1 or cols[j]==-1:
                    matrix[i][j]=0
