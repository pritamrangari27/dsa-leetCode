from bisect import bisect_left

class BIT:
    def __init__(self, n):
        self.bit = [0] * (n + 1)

    def update(self, i):
        while i < len(self.bit):
            self.bit[i] += 1
            i += i & -i

    def query(self, i):
        s = 0
        while i > 0:
            s += self.bit[i]
            i -= i & -i
        return s

class Solution(object):
    def countMajoritySubarrays(self, nums, target):
        prefix = [0]
        s = 0

        for x in nums:
            s += 1 if x == target else -1
            prefix.append(s)

        vals = sorted(set(prefix))
        bit = BIT(len(vals))
        ans = 0

        for x in prefix:
            idx = bisect_left(vals, x) + 1
            ans += bit.query(idx - 1)
            bit.update(idx)

        return ans
