class Solution(object):
    def removeNthFromEnd(self, head, n):
        temp=head
        length=1
        while temp.next is not None:    
            temp=temp.next
            length+=1
        if n==length:
            return head.next
        pos=length-n
        temp=head
        count=1
        while count<pos:
            temp=temp.next
            count+=1
        temp.next=temp.next.next
        return head

Solution 2:
class Solution:
    def removeNthFromEnd(self, head, n):
        # Step 1: find length
        length = 0
        curr = head
        while curr:
            length += 1
            curr = curr.next

        # Step 2: if head needs to be removed
        if n == length:
            return head.next

        # Step 3: move to node before deletion
        curr = head
        for _ in range(length - n - 1):
            curr = curr.next

        # Step 4: delete node
        curr.next = curr.next.next
        return head




        
