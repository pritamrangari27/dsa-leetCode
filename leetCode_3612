class Solution:
    def processStr(self, s) :
        res = []

        for ch in s:
            if 'a' <= ch <= 'z':
                res.append(ch)
            elif ch == '*':
                if res:
                    res.pop()
            elif ch == '#':
                res.extend(res)
            else:  # '%'
                res.reverse()

        return ''.join(res)
