class Solution(object):
    def pathExistenceQueries(self, n, nums, maxDiff, queries):
        arr = sorted((nums[i], i) for i in range(n))
        pos = [0] * n
        vals = [0] * n
        for p, (val, idx) in enumerate(arr):
            vals[p] = val
            pos[idx] = p
        comp = [0] * n
        for i in range(1, n):
            comp[i] = comp[i - 1]
            if vals[i] - vals[i - 1] > maxDiff:
                comp[i] += 1
        nxt = [0] * n
        r = 0
        for l in range(n):
            while r + 1 < n and vals[r + 1] - vals[l] <= maxDiff:
                r += 1
            nxt[l] = r
        LOG = n.bit_length()
        up = [nxt]
        for _ in range(1, LOG):
            prev = up[-1]
            curr = [0] * n
            for i in range(n):
                curr[i] = prev[prev[i]]
            up.append(curr)
        ans = []
        for u, v in queries:
            a = pos[u]
            b = pos[v]
            if a > b:
                a, b = b, a
            if a == b:
                ans.append(0)
                continue
            if comp[a] != comp[b]:
                ans.append(-1)
                continue
            cur = a
            steps = 0
            for k in range(LOG - 1, -1, -1):
                if up[k][cur] < b:
                    cur = up[k][cur]
                    steps += 1 << k
            ans.append(steps + 1)
        return ans
