def longSubstringWithoutRepeating(s):
    if not s:
        return 0

    n = len(s)
    maxi = 0

    for i in range(n):
        mySet = set()
        count = 0

        for j in range(i, n):
            if s[j] in mySet:
                break
            else:
                mySet.add(s[j])
                count += 1

            if count > maxi:
                maxi = count

    return maxi
