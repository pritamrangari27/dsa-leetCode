class Solution(object):
    def stoneGameIII(self, stoneValue):
        n = len(stoneValue)
        dp = [0] * (n + 1)
        for i in range(n - 1, -1, -1):
            dp[i] = float("-inf")
            curr = 0
            for j in range(i, min(i + 3, n)):
                curr += stoneValue[j]
                dp[i] = max(dp[i], curr - dp[j + 1])
        if dp[0] > 0:
            return "Alice"
        elif dp[0] < 0:
            return "Bob"
        else:
            return "Tie"
