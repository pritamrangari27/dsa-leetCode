class Solution(object):
    def checkIfExist(self, arr):
        n=len(arr)
        if n<2:
            return False
        for i in range(0,n-1):
            for j in range(i+1,n):
                if arr[i]==(2*arr[j]) or arr[j]==(2*arr[i]):
                    return True
        return False
        
