class Solution(object):
    def sumAndMultiply(self, s, queries):
        MOD = 10**9 + 7
        n = len(s)
        pref_val = [0] * (n + 1)
        pref_cnt = [0] * (n + 1)
        pref_sum = [0] * (n + 1)
        pow10 = [1] * (n + 1)
        for i in range(1, n + 1):
            pow10[i] = (pow10[i - 1] * 10) % MOD
        for i, ch in enumerate(s):
            pref_val[i + 1] = pref_val[i]
            pref_cnt[i + 1] = pref_cnt[i]
            pref_sum[i + 1] = pref_sum[i]
            if ch != '0':
                d = int(ch)
                pref_val[i + 1] = (pref_val[i] * 10 + d) % MOD
                pref_cnt[i + 1] += 1
                pref_sum[i + 1] += d
        ans = []
        for l, r in queries:
            cnt = pref_cnt[r + 1] - pref_cnt[l]
            digit_sum = pref_sum[r + 1] - pref_sum[l]
            num = (pref_val[r + 1] - pref_val[l] * pow10[cnt]) % MOD
            ans.append((num * digit_sum) % MOD)
        return ans
