class Solution(object):
    def pathExistenceQueries(self, n, nums, maxDiff, queries):
        comp = [0] * n
        comp_id = 0
        for i in range(1, n):
            if nums[i] - nums[i - 1] > maxDiff:
                comp_id += 1
            comp[i] = comp_id
        ans = []
        for u, v in queries:
            ans.append(comp[u] == comp[v])
        return ans
