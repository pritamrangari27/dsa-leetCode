class Solution(object):
    def longestConsecutive(self, nums):
        seen=set()
        for num in nums:
            seen.add(num)
        longest=0
        for num in seen:
            if num-1 not in seen:
                x=num
                count=1
                while x+1 in seen:
                    x+=1
                    count+=1
                if count>longest:
                    longest=count
        return longest
        
