class Solution:
    def resultArray(self, nums, k):
        n = len(nums)
        dp = [0] * k
        ans = [0] * k
        for x in nums:
            x %= k
            new_dp = [0] * k
            new_dp[x] += 1
            for r in range(k):
                if dp[r]:
                    new_r = (r * x) % k
                    new_dp[new_r] += dp[r]
            dp = new_dp
            for r in range(k):
                ans[r] += dp[r]
        return ans
