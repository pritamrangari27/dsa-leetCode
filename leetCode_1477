class Solution:
    def minSumOfLengths(self, arr, target):
        n = len(arr)
        best = [float('inf')] * n
        prefix = 0
        last = {0: -1}
        ans = float('inf')
        min_len = float('inf')
        for i in range(n):
            prefix += arr[i]
            if prefix - target in last:
                j = last[prefix - target]
                length = i - j
                if j >= 0 and best[j] != float('inf'):
                    ans = min(ans, length + best[j])
                min_len = min(min_len, length)
            best[i] = min_len
            last[prefix] = i
        return -1 if ans == float('inf') else ans
