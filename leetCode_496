class Solution(object):
    def nextGreaterElement(self, nums1, nums2):

        res = []

        for i in nums1:

            found = -1

            for j in range(len(nums2)):

                if i == nums2[j]:

                    for k in range(j + 1, len(nums2)):

                        if nums2[k] > nums2[j]:
                            found = nums2[k]
                            break

                    break

            res.append(found)

        return res
