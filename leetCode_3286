from collections import deque
class Solution:
    def findSafeWalk(self, grid, health):
        m, n = len(grid), len(grid[0])
        start_health = health - grid[0][0]
        if start_health <= 0:
            return False
        max_health = [[-1] * n for _ in range(m)]
        max_health[0][0] = start_health
        q = deque([(0, 0, start_health)])
        directions = [(1, 0), (-1, 0), (0, 1), (0, -1)]
        while q:
            r, c, curr_health = q.popleft()
            if r == m - 1 and c == n - 1:
                return True
            for dr, dc in directions:
                nr, nc = r + dr, c + dc
                if 0 <= nr < m and 0 <= nc < n:
                    new_health = curr_health - grid[nr][nc]
                    if new_health > 0 and new_health > max_health[nr][nc]:
                        max_health[nr][nc] = new_health
                        q.append((nr, nc, new_health))
        return False
