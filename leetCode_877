class Solution(object):
    def stoneGame(self, piles):
        n = len(piles)
        dp = [[0] * n for _ in range(n)]
        for i in range(n):
            dp[i][i] = piles[i]
        for length in range(2, n + 1):
            for i in range(n - length + 1):
                j = i + length - 1
                pickLeft = piles[i] - dp[i + 1][j]
                pickRight = piles[j] - dp[i][j - 1]
                dp[i][j] = max(pickLeft, pickRight)
        return dp[0][n - 1] > 0
