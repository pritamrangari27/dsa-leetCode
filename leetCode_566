class Solution(object):
    def matrixReshape(self, mat, r, c):
        row=len(mat)
        col=len(mat[0])

        if row*col!=r*c:
            return mat
        
        arr=[]
        for i in mat:
            for j in i:
                arr.append(j)
        
        result=[]
        index=0

        for i in range(r):
            temp=[]
            for j in range(c):
                temp.append(arr[index])
                index+=1
            result.append(temp)
        
        return result
    
        
